<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Workoutly.Mobile.Services" x:Class="Workoutly.Mobile.PlanExercisePickerPage" Title="Selecionar exercício">
    <Grid Padding="20,16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <VerticalStackLayout Spacing="6">
            <Label Text="EXERCÍCIOS DA FICHA" Style="{StaticResource Eyebrow}" />
            <Label Text="Adicionar exercício" Style="{StaticResource PageTitle}" />
            <Border Style="{StaticResource InputBorder}"><Entry x:Name="Search" Placeholder="Buscar por nome ou grupo muscular" TextChanged="OnSearch" AutomationId="plan_exercise_search" /></Border>
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button x:Name="CreateButton" Text="Cadastrar exercício" Clicked="OnCreate" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="1" x:Name="RefreshButton" Text="Atualizar" Clicked="OnRefresh" Style="{StaticResource TextButton}" />
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <ActivityIndicator x:Name="Loading" IsVisible="False" />
            <Label x:Name="ErrorText" TextColor="{StaticResource Error}" IsVisible="False" />
            <Label Text="Toque em um exercício para incluir. Itens já adicionados ficam ocultos." Style="{StaticResource SecondaryText}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="3" x:Name="ExerciseList" SelectionMode="Single" SelectionChanged="OnSelected" AutomationId="plan_exercise_picker">
            <CollectionView.EmptyView><Label Text="Nenhum exercício disponível para esta busca." Style="{StaticResource SecondaryText}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ExerciseItem">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="18" />
                            <Label Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                            <Label Text="{Binding Origin}" TextColor="{StaticResource Mint}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
