<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Workoutly.Mobile.PlanPage" Title="Ficha de treino">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="14" MaximumWidthRequest="600">
            <Label Text="PLANEJAMENTO" Style="{StaticResource Eyebrow}" />
            <Label x:Name="Heading" Text="Nova ficha" Style="{StaticResource PageTitle}" />
            <Label Text="Defina a ordem, as séries e as repetições previstas. Esses valores são metas desta ficha." Style="{StaticResource SecondaryText}" />
            <VerticalStackLayout x:Name="Form" Spacing="14">
                <Border Style="{StaticResource InputBorder}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Nome da ficha" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="NameEntry" Placeholder="Ex.: Treino A — Peito e tríceps" MaxLength="120" AutomationId="plan_name" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource InputBorder}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observações (opcional)" Style="{StaticResource FieldLabel}" />
                        <Editor x:Name="NotesEntry" Placeholder="Orientações para este planejamento" MaxLength="1000" AutoSize="TextChanges" MinimumHeightRequest="65" AutomationId="plan_notes" />
                    </VerticalStackLayout>
                </Border>
                <Label x:Name="CountText" Text="Exercícios (0)" FontFamily="InterSemiBold" FontSize="18" />
                <VerticalStackLayout x:Name="ItemsPanel" Spacing="12" />
                <Button Text="Adicionar exercício" Clicked="OnAdd" Style="{StaticResource SecondaryButton}" AutomationId="plan_add_exercise" />
                <Button x:Name="SaveButton" Text="Salvar ficha" Clicked="OnSave" AutomationId="plan_save" />
                <Button x:Name="ReloadButton" Text="Recarregar ficha" Clicked="OnReload" Style="{StaticResource TextButton}" IsVisible="False" />
                <Button x:Name="DeleteButton" Text="Excluir ficha" Clicked="OnDelete" Style="{StaticResource TextButton}" TextColor="{StaticResource Error}" IsVisible="False" AutomationId="plan_delete" />
            </VerticalStackLayout>
            <ActivityIndicator x:Name="Loading" IsVisible="False" />
            <Label x:Name="ErrorText" TextColor="{StaticResource Error}" IsVisible="False" AutomationId="plan_error" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
