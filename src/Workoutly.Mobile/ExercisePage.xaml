<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Workoutly.Mobile.ExercisePage" Title="Novo exercício" BackgroundColor="#111827">
    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="14" MaximumWidthRequest="560">
            <Label x:Name="Heading" Text="Cadastre seu movimento" TextColor="#F9FAFB" FontSize="26" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label x:Name="OriginText" Text="Este exercício será visível somente para sua conta." TextColor="#C4B5FD" />
            <ActivityIndicator x:Name="Loading" Color="#A78BFA" IsVisible="False" />
            <Label x:Name="ErrorText" TextColor="#FDA4AF" IsVisible="False" AutomationId="exercise_form_error" />
            <VerticalStackLayout x:Name="Fields" Spacing="12">
                <Label Text="Nome" TextColor="#CBD5E1" />
                <Entry x:Name="NameEntry" Placeholder="Ex.: Remada unilateral" MaxLength="120" TextColor="#F9FAFB" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" AutomationId="exercise_name" />
                <Label Text="Grupo muscular" TextColor="#CBD5E1" />
                <Entry x:Name="GroupEntry" Placeholder="Ex.: Costas" MaxLength="60" TextColor="#F9FAFB" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" AutomationId="exercise_group" />
                <Label Text="Equipamento" TextColor="#CBD5E1" />
                <Entry x:Name="EquipmentEntry" Placeholder="Ex.: Halteres ou Peso corporal" MaxLength="80" TextColor="#F9FAFB" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" AutomationId="exercise_equipment" />
                <Label Text="Descrição (opcional)" TextColor="#CBD5E1" />
                <Editor x:Name="DescriptionEditor" Placeholder="Como você identifica esta variação?" MaxLength="1000" AutoSize="TextChanges" MinimumHeightRequest="100"
                        TextColor="#F9FAFB" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" AutomationId="exercise_description" />
            </VerticalStackLayout>
            <Button x:Name="SaveButton" Text="Salvar exercício" Clicked="OnSave" BackgroundColor="#A78BFA" TextColor="#111827" AutomationId="exercise_save" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
