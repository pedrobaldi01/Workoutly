<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Workoutly.Mobile.MainPage"
             Title="Workoutly" BackgroundColor="#111827">
    <ScrollView>
        <VerticalStackLayout Padding="28,40" Spacing="24" MaximumWidthRequest="560">
            <Label Text="WORKOUTLY" TextColor="#A78BFA" FontSize="14"
                   CharacterSpacing="3" FontAttributes="Bold" />
            <Label Text="Seu treino, no seu ritmo." TextColor="#F9FAFB"
                   FontSize="34" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Organize seus treinos e acompanhe sua evolução."
                   TextColor="#CBD5E1" FontSize="18" />
            <Border BackgroundColor="#1F2937" StrokeThickness="0" Padding="24">
                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Uma rotina que faz sentido para você" TextColor="#F9FAFB"
                           FontSize="22" FontAttributes="Bold" />
                    <Label Text="Planeje suas fichas" TextColor="#C4B5FD" FontSize="18" />
                    <Label Text="Registre cada sessão" TextColor="#C4B5FD" FontSize="18" />
                    <Label Text="Enxergue sua evolução" TextColor="#C4B5FD" FontSize="18" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
